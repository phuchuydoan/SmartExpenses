# MySQL connection (see docker-compose.yml for a local database)
DATABASE_URL="mysql://smartspend:smartspend@localhost:3306/smartspend"

# Server
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Auth - use a long random string in production
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Gemini - the key lives ONLY on the backend. Never put it in the React app.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
